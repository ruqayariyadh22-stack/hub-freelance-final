NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
DATABASE_URL=postgresql://username:your_database_password_here@127.0.0.1:5432/hub_freelance
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_database_password_here
PGDATABASE=hub_freelance
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=
CONTACT_EMAIL=

# Public base URL used for uploaded file links (defaults to the request host)
PUBLIC_API_URL=
